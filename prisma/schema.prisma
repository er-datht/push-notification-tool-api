// Prisma schema — the single source of truth for the database structure.
//
// Workflow for every schema change:
//   1. edit a model here
//   2. yarn db:migrate --name <what_changed>   (writes SQL under prisma/migrations/ and applies it)
//   3. commit schema.prisma AND the new migration folder together
// Never change tables by hand in TablePro on a shared environment.
//
// The connection URL lives in prisma.config.ts (Prisma 7), not here.

generator client {
  provider = "prisma-client"
  // Generated under src/ so tsc compiles it into dist/ with the rest of the
  // app — the server needs it at runtime. Git-ignored; rebuilt from this
  // schema with `yarn db:generate`.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// One accepted POST /api/notifications/auto-app-pushes.
model PushRun {
  id            BigInt        @id @default(autoincrement())
  /// The `date` of the request (Tokyo calendar date), stored as a DATE.
  date          DateTime      @db.Date
  distributeNow Boolean       @map("distribute_now")
  /// The login_ids as sent. JSON: never queried by element.
  loginIds      Json          @map("login_ids")
  createdAt     DateTime      @default(now()) @map("created_at")
  editions      PushEdition[]

  @@map("push_runs")
}

/// One edition of a run — one delivery file.
model PushEdition {
  id        BigInt   @id @default(autoincrement())
  runId     BigInt   @map("run_id")
  run       PushRun  @relation(fields: [runId], references: [id])
  delivId   String   @map("deliv_id") @db.VarChar(24)
  title     String   @db.Text
  linkType  String   @map("link_type") @db.Char(2)
  linkItem  String   @map("link_item") @db.VarChar(255)
  /// The delivery instant, UTC. Tokyo wall-clock time is derived on read.
  publishAt DateTime @map("publish_at")
  /// Path of the delivery file relative to PUSH_FILE_DIR.
  filePath  String   @map("file_path") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([runId])
  @@map("push_editions")
}

/// One accepted POST /api/notifications/normal-pushes. Its editions and topics are what
/// ecs-api's `PushTest::Common.create_topics_edition` builds (docs/create_topics_edition_flow.md);
/// nothing is delivered — the notification pipeline after that method runs only in ecs-api.
model NormalPushRun {
  id            BigInt              @id @default(autoincrement())
  /// The `date` of the request (Tokyo calendar date), stored as a DATE.
  date          DateTime            @db.Date
  distributeNow Boolean             @map("distribute_now")
  createdAt     DateTime            @default(now()) @map("created_at")
  editions      NormalPushEdition[]

  @@map("normal_push_runs")
}

/// ecs-api's `Epica::TopicsEditionV2#status`. This service only ever reaches `edited`: `set`
/// needs the notification pipeline, which runs in ecs-api.
enum NormalPushEditionStatus {
  created
  edited
  set
}

/// One edition (one notification) of a normal-push run: a one-hour window holding 1+ shows.
/// Mirrors ecs-api's `epica_topics_editions_v2` — what `create_topics_edition` creates
/// (docs/create_topics_edition_flow.md, step 2).
model NormalPushEdition {
  id          BigInt                  @id @default(autoincrement())
  runId       BigInt                  @map("run_id")
  run         NormalPushRun           @relation(fields: [runId], references: [id])
  /// The start of the one-hour window, UTC. Tokyo wall-clock time is derived on read.
  periodStart DateTime                @map("period_start")
  /// periodStart + 1 hour.
  periodEnd   DateTime                @map("period_end")
  status      NormalPushEditionStatus @default(created)
  /// When the topics were created (`edited!`).
  editedAt    DateTime?               @map("edited_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  shows       NormalPushShow[]
  topics      NormalPushTopic[]

  @@index([runId])
  /// The overlap check (NP-0208) compares windows: period_start < new end AND period_end > new start.
  @@index([periodStart])
  @@index([periodEnd])
  @@map("normal_push_editions")
}

/// One topic of an edition — one per performance. A show whose code has a P021 part makes one;
/// a code without it is expanded through the e+ search API into one per performance, up to 200.
/// Mirrors ecs-api's `epica_topics_v2` plus its single `epica_topic_areas_v2` row
/// (docs/create_topics_edition_flow.md, steps 3-4).
model NormalPushTopic {
  id            BigInt            @id @default(autoincrement())
  editionId     BigInt            @map("edition_id")
  edition       NormalPushEdition @relation(fields: [editionId], references: [id])
  /// The performer: `tag:eplus.jp,2010:performers/<performer_id padded to 10 digits>`.
  subjectUri    String            @map("subject_uri") @db.VarChar(191)
  /// The performance: `tag:eplus.jp,2010:shows/<kogyo>-<sub>-<koen>`.
  objectUri     String            @map("object_uri") @db.VarChar(191)
  hook          String            @db.VarChar(16)
  /// Always the edition's periodStart.
  willPublishAt DateTime          @map("will_publish_at")
  /// Always `anywhere` (全国): create_topics_edition does not filter by prefecture.
  area          String            @default("anywhere") @db.VarChar(32)
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([editionId])
  @@map("normal_push_topics")
}

/// One show inside an edition, as sent: `{ code, performer_id, hook }`.
model NormalPushShow {
  id          BigInt            @id @default(autoincrement())
  editionId   BigInt            @map("edition_id")
  edition     NormalPushEdition @relation(fields: [editionId], references: [id])
  code        String            @db.VarChar(64)
  /// The ワード id. Up to 16 digits, so it does not fit INT.
  performerId BigInt            @map("performer_id")
  hook        String            @db.VarChar(16)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([editionId])
  @@map("normal_push_shows")
}
