# Copy to .env and adjust. .env is git-ignored; this file is the documentation.
# src/lib/env.ts validates every variable the app reads at startup.

# --- App ---------------------------------------------------------------------
# The FE docs expect the local backend on 8080.
PORT=8080
NODE_ENV=development
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Origin allowed by CORS. The FE dev server. Comma-separate to allow several.
CORS_ORIGIN=http://localhost:3000

# --- Database ----------------------------------------------------------------
# What the app and Prisma read. Must agree with the MYSQL_* values below.
# 127.0.0.1, not localhost: "localhost" can mean a Unix socket to a MySQL
# driver, and there is no socket when MySQL runs in Docker.
DATABASE_URL=mysql://push:push@127.0.0.1:3306/push_notification_tool

# --- docker-compose only -----------------------------------------------------
# Read by docker-compose.yml to create the container. Not read by the app.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=push_notification_tool
MYSQL_USER=push
MYSQL_PASSWORD=push
MYSQL_PORT=3306
