# src/lib/env.ts validates every variable the app reads at startup.

# --- App ---------------------------------------------------------------------
PORT=
NODE_ENV=
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=
# Origin allowed by CORS. The FE dev server. Comma-separate to allow several.
CORS_ORIGIN=
# Shared secret the FE sends as X-APIToken on the API routes.
API_TOKEN=
# Directory the delivery CSV files are written to, relative to the process cwd.
PUSH_FILE_DIR=

# --- Database ----------------------------------------------------------------
DATABASE_URL=

# --- docker-compose only -----------------------------------------------------
# Read by docker-compose.yml to create the container. Not read by the app.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=
