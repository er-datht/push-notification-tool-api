# src/lib/env.ts validates every variable the app reads at startup.

# --- App ---------------------------------------------------------------------
PORT=
NODE_ENV=
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=
# Origin allowed by CORS. The FE dev server. Comma-separate to allow several.
CORS_ORIGIN=
# Shared secret the FE sends as X-APIToken on the API routes.
API_TOKEN=
# Directory the delivery CSV files are written to, relative to the process cwd.
PUSH_FILE_DIR=

# --- Database ----------------------------------------------------------------
DATABASE_URL=

# --- AWS -----------------------------------------------------------------------
# Region and bucket the delivery CSV is also uploaded to.
AWS_REGION=
S3_BUCKET_NAME=
# Not read by env.ts — the AWS SDK's own default credential chain picks these
# up directly from the environment if you need static keys locally (otherwise
# ~/.aws/credentials or an IAM role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- docker-compose only -----------------------------------------------------
# Read by docker-compose.yml to create the container. Not read by the app.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=
