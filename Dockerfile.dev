# Development image for the `api` service in docker-compose.yml. Not for
# staging/production: it runs `tsx watch` against the source bind-mounted from
# the host, so edits restart the server the same way `yarn dev` does locally.
#
# Only the dependencies are baked in. node_modules lives in the image (an
# anonymous volume in compose keeps the host's macOS binaries out), the source
# never does.
FROM node:22-bookworm-slim

# The Prisma CLI's schema engine (migrate) links against OpenSSL.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

# On every start: rebuild the Prisma client from the mounted schema, apply any
# migration the database does not have yet, then watch. `migrate deploy` needs
# no shadow database and never prompts; new migrations are still written with
# `docker compose exec api yarn db:migrate --name <what_changed>`.
CMD ["sh", "-c", "yarn db:generate && yarn db:deploy && yarn dev"]
