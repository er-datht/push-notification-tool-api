# Dependencies
node_modules

# Build output (tsc writes here; only source is committed)
dist

# Prisma generates the client into this folder on `yarn db:generate`.
# It is derived from schema.prisma, so it is rebuilt, never committed.
prisma/generated

# Env — real values hold the DB password. Only the example is tracked.
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / tooling output
coverage
*.tsbuildinfo
.eslintcache

# Package managers — this project uses yarn
package-lock.json
pnpm-lock.yaml
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.swp

# Claude Code — per-user overrides
.claude/settings.local.json
